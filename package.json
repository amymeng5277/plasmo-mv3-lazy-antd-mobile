{
  "name": "plasmo-mv3-lazy-antd-mobile",
  "displayName": "Plasmo MV3 Lazy UI Demo",
  "version": "0.1.0",
  "description": "Lazy-load Ant Design Mobile and Tailwind CSS from a tiny MV3 content script",
  "private": true,
  "scripts": {
    "dev": "plasmo dev --target=chrome-mv3",
    "build": "plasmo build --target=chrome-mv3",
    "verify": "node scripts/inspect-build.mjs"
  },
  "dependencies": {
    "antd-mobile": "5.43.0",
    "plasmo": "0.90.5",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.288",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  },
  "manifest": {
    "web_accessible_resources": [
      {
        "resources": ["resources/demo.json"],
        "matches": ["https://example.com/*"]
      }
    ]
  }
}
